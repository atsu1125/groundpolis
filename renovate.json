{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"config:recommended",
		":timezone(Asia/Tokyo)"
	],
	"schedule": [
		"after 10pm every weekend",
		"before 5am every weekend"
	],
	"dependencyDashboard": true,
	"major": {
		"enabled": false
	},
	"minor": {
		"enabled": false
	},
	"packageRules": [
		{
			"matchUpdateTypes": [
				"patch",
				"pin",
				"digest"
			],
			"automerge": true
		}
	]
}
